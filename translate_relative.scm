(define x-offset 5)
(define x-start -2)
(define x-end 2)
(define dx 1)

(define y-offset 5)
(define y-start -2)
(define y-end 2)
(define dy 1)

(define current-x 0)
(define current-y 0)

(do ((x_target x-start (+ x_target dx)))
    ((> x_target x-end))
  (do ((y_target y-start (+ y_target dy)))
      ((> y_target y-end))
    (let* ((abs-target-x (+ x-offset x_target))
           (abs-target-y (+ y-offset y_target))
           (current-abs-x (+ x-offset current-x))
           (current-abs-y (+ y-offset current-y))
           (command-x (- abs-target-x current-abs-x))
           (command-y (- abs-target-y current-abs-y)))
      (set! current-x (+ current-x command-x))
      (set! current-y (+ current-y command-y))
      (let ((new-abs-x (+ x-offset current-x))
            (new-abs-y (+ y-offset current-y)))
        (display "Moving by command: ") (display command-x) (display " ") (display command-y)
        (display " -> New absolute position: ") (display new-abs-x) (display " ") (display new-abs-y) (newline)
        (display "Recording at absolute position: ") (display new-abs-x) (display " ") (display new-abs-y) (newline))))))
